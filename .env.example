# Public configuration only. NEXT_PUBLIC_* values are exposed to browsers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=31611
NEXT_PUBLIC_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_EXPLORER_URL=https://explorer.test.mezo.org
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
NEXT_PUBLIC_PACTORA_ESCROW_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
SESSION_SECRET=
# Legacy optional setting, unused by V2. Wallet sessions are opaque tokens hashed in PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pactora
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=http://localhost:3000/api/telegram/webhook
APP_URL=http://localhost:3000
LINK_TOKEN_SECRET=your-secure-32-byte-hex-link-secret
# Legacy optional setting, unused by V2. Link tokens are random and only their SHA-256 hashes persist.
RATE_LIMIT_SECRET=
# Required: at least 32 random bytes. IP headers are trusted only on Vercel; other hosts share a route bucket.
ALLOW_TEST_NOTIFICATIONS=false
# Only the literal "true" enables test notifications in production.

# Optional monitoring/indexing
SENTRY_DSN=
